      "properties": {
        "fieldIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "omittedUpstreamIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "unknownFields": {
          "enum": [
            "preserveExact",
            "ignore",
            "discard"
          ]
        },
        "codec": {
          "enum": [
            "boundedJSON",
            "codable"
          ]
        },
        "direction": {
          "enum": [
            "request",
            "response"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "codec"
            ],
            "properties": {
              "codec": {
                "const": "codable"
              }
            }
          },
          "then": {
            "properties": {
              "unknownFields": {
                "enum": [
                  "ignore",
                  "discard"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "unknownFields": {
                "const": "preserveExact"
              }
            }
          }
        }
      ]
    },

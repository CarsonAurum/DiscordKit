{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordkit.invalid/parity/reviewed-v1.schema.json",
  "title": "DiscordKit reviewed parity contracts, version 1",
  "description": "Finite reviewed definitions used by offline generation. Semantic validation additionally verifies exact discovery membership, source revision/hash pins, explicit freshness dates, reciprocal graph ownership, exhaustive included/omitted model field groups, support classification, safe real repository declarations and executable test or structured JSON fixture evidence. Upstream dates and local support dates remain separate; this document does not claim full API parity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verifiedOn",
    "maxAgeDays",
    "sources",
    "definitions",
    "symbols",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "verifiedOn": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "maxAgeDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 366
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
